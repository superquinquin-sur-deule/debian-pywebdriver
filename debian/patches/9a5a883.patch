+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+""" Smoke test : imprime un reçu XML + texte accentué + image base64
+    sans matériel, en capturant les octets dans un BytesIO. """
+
+import io
+
+from escpos import Escpos
+
+
+class CapturingPrinter(Escpos):
+    """ Sous-classe qui capture les octets au lieu d'envoyer à une imprimante """
+
+    def __init__(self):
+        self.buffer = io.BytesIO()
+
+    def _raw(self, msg):
+        if isinstance(msg, str):
+            msg = msg.encode('latin-1')
+        self.buffer.write(msg)
+
+
+# petit PNG 1x1 (un pixel transparent) encodé en base64
+PNG_1PX = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=='
+
+RECEIPT_XML = """<receipt>
+      <h1>Mon magasin</h1>
+      <p>Bonjour, total: <value>12.50</value></p>
+      <line><left>Article</left><right>5.99 EUR</right></line>
+      <line ratio="0.3"><left>Remise</left><right>-1.00</right></line>
+      <ul>
+        <li>un</li>
+        <li>deux</li>
+      </ul>
+      <ol>
+        <li>premier</li>
+        <li>second</li>
+      </ol>
+      <hr/>
+      <em>accentue</em> <b>gras</b>
+      <img src="data:image/png;base64,{png}"/>
+      <br/>
+    </receipt>""".format(png=PNG_1PX)
+
+
+def main():
+    printer = CapturingPrinter()
+    printer.receipt(RECEIPT_XML)
+    printer.text("Accents: e-acute a-grave c-cedilla\n")
+    printer.hw('INIT')
+    printer.cut()
+    data = printer.buffer.getvalue()
+    assert isinstance(data, bytes) and len(data) > 0, "no bytes captured"
+    print("OK: captured %d bytes" % len(data))
+
+
+if __name__ == '__main__':
+    main()
