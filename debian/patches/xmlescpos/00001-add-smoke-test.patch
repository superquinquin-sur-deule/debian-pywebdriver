+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+""" Smoke test: print an XML receipt, accented text and a base64 image,
+    capturing the bytes into a BytesIO without any printer hardware. """
+
+import io
+
+from escpos import Escpos
+
+
+class CapturingPrinter(Escpos):
+    """ Escpos subclass that captures bytes instead of sending them to a printer. """
+
+    def __init__(self):
+        self.buffer = io.BytesIO()
+
+    def _raw(self, msg):
+        if isinstance(msg, str):
+            msg = msg.encode('latin-1')
+        self.buffer.write(msg)
+
+
+# tiny 1x1 PNG (one transparent pixel) in base64
+PNG_1PX = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=='
+
+RECEIPT_XML = """<receipt>
+      <h1>My shop</h1>
+      <p>Hello, total: <value>12.50</value></p>
+      <line><left>Item</left><right>5.99 EUR</right></line>
+      <line ratio="0.3"><left>Discount</left><right>-1.00</right></line>
+      <ul>
+        <li>one</li>
+        <li>two</li>
+      </ul>
+      <ol>
+        <li>first</li>
+        <li>second</li>
+      </ol>
+      <hr/>
+      <em>déjà</em> <b>bold</b>
+      <img src="data:image/png;base64,{png}"/>
+      <br/>
+    </receipt>""".format(png=PNG_1PX)
+
+
+def main():
+    printer = CapturingPrinter()
+    printer.receipt(RECEIPT_XML)
+    printer.text("Accents: e-acute a-grave c-cedilla\n")
+    printer.hw('INIT')
+    printer.cut()
+    data = printer.buffer.getvalue()
+    assert isinstance(data, bytes) and len(data) > 0, "no bytes captured"
+    print("OK: captured %d bytes" % len(data))
+
+
+if __name__ == '__main__':
+    main()
