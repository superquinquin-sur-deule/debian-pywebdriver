+class _ReceiptBuffer(Escpos):
+    """ Escpos target that accumulates the rendered bytes in memory.
+
+    Used by :class:`Layout` to render a whole receipt to ESC/POS data
+    before sending it to a python-escpos printer object.
+    """
+
+    def __init__(self):
+        self.buffer = io.BytesIO()
+
+    def _raw(self, msg):
+        if isinstance(msg, str):
+            msg = msg.encode('latin-1')
+        self.buffer.write(msg)
+
+
+class Layout:
+    """ Render an xmlescpos XML receipt onto a python-escpos printer.
+
+    pywebdriver wraps its ESC/POS driver as a python-escpos printer object
+    and calls ``Layout(content).format(printer)``. The whole receipt is
+    rendered to ESC/POS bytes (styles, encodings, images, barcodes) and
+    pushed to the printer with a single ``printer._raw()`` call.
+    """
+
+    def __init__(self, content):
+        self.content = content
+
+    def format(self, printer):
+        renderer = _ReceiptBuffer()
+        renderer.receipt(self.content, cut=False)
+        printer._raw(renderer.buffer.getvalue())
